# Ports
BACKEND_PORT=4000
REACT_PORT=3000
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=ciri-broker
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-password
RABBITMQ_URL=amqp://ciri-broker:replace-with-a-strong-password@rabbitmq:5672

# Database
POSTGRES_HOST=postgres
POSTGRES_USER=username
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myciridb

# External APIs
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Public origins
REACT_URL=https://your-frontend.example
VITE_API_URL=https://your-backend.example/api
