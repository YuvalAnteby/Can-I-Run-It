# Ports
BACKEND_PORT=4000
REACT_PORT=3000
POSTGRES_PORT=5432

# Database
POSTGRES_HOST=postgres
POSTGRES_USER=username
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myciridb
POSTGRES_AUTH_MODE=password
POSTGRES_SSL_MODE=disable
POSTGRES_SSL_CA_FILE=
POSTGRES_POOL_MAX=5
POSTGRES_STARTUP_RETRY_BUDGET_MS=30000
# Azure Entra mode requires verify-full TLS, an explicit host/user/database,
# a managed-identity client ID, and an empty POSTGRES_PASSWORD.
AZURE_CLIENT_ID=

# External APIs
GEMINI_API_KEY=
RAWG_API_KEY=

# Abuse protection (validated at startup)
EXPENSIVE_REQUESTS_PER_IP_PER_MINUTE=10
EXPENSIVE_REQUESTS_GLOBAL_PER_MINUTE=100
GEMINI_REQUESTS_PER_MINUTE=30
RAWG_REQUESTS_PER_MINUTE=60
GEMINI_MAX_CONCURRENT=2
RAWG_MAX_CONCURRENT=4
GEMINI_TIMEOUT_MS=8000
RAWG_TIMEOUT_MS=3000
# 0 by default; set to 1 only behind a verified single-hop ingress.
TRUST_PROXY=0

# Observability (disabled locally; production Terraform can inject these)
TELEMETRY_ENABLED=false
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_TRACES_SAMPLER_ARG=0.1
LOG_LEVEL=info

# Public origins
REACT_URL=https://your-frontend.example
VITE_API_URL=https://your-backend.example/api

# Production only: set to the scanned GHCR sha-<full-commit> tag after release.
BACKEND_IMAGE=
