{
  "scripts": {
    "docker:dev": "docker compose --env-file infra/.env -f infra/docker-compose.yml up -d --build",
    "docker:prod": "docker compose --env-file infra/.env -f infra/docker-compose.prod.yml up -d --build",
    "docker:down": "docker compose --env-file infra/.env -f infra/docker-compose.yml down",
    "docker:logs": "docker compose --env-file infra/.env -f infra/docker-compose.yml logs -f",
    "format": "npm run format --prefix backend && npm run format --prefix frontend",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "docker:test:backend": "docker compose -f infra/docker-compose.tests.yml up --build --exit-code-from backend --abort-on-container-exit",
    "seed": "cd backend && npm run seed:postgres",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "backend/**/*.{js,ts}": [
      "npm --prefix backend run lint --",
      "npx prettier --write"
    ],
    "frontend/**/*.{js,ts,jsx,tsx}": [
      "npm --prefix frontend run lint --",
      "npx prettier --write"
    ]
  }
}
