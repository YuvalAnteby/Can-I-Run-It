{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "plugins": ["@nestjs/swagger/plugin"],
        "assets": [{ "include": "database/init-scripts/*.sql", "watchAssets": true }],
        "deleteOutDir": true
    }
}
